<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Plant</title>
  </head>
  <body>
    <form method="POST" action="/edit/<%= plant._id %>">
      <h1>Edit Plant</h1>

      <label for="name">Name</label>
      <input
        id="name"
        name="name"
        type="text"
        required
        value="<%= plant.name%>"
      />

      <label for="light">Lighting</label>
      <select name="light" id="light" required>
        <% ['low', 'medium', 'bright'].forEach(opt => { %>
          <option value="<%= opt %>" <%= plant.light === opt ? 'selected' : '' %>>
            <%= opt[0].toUpperCase() + opt.slice(1) %>
          </option>
        <% }) %>
      </select>

      <label for="lastWatered">Last Watered</label>
      <input
        id="lastWatered"
        name="lastWatered"
        type="date"
        value="<%= plant.lastWatered ? new Date(plant.lastWatered).toISOString().slice(0, 10) : '' %>">
      

      <button type="submit">Save</button>
      <button><a href="/profile">Cancel</a></button>
    </form>
  </body>
</html>
